    "No head tracking (drag the pointer to the edge to look around)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kopftracking (Zeiger an den Rand ziehen, um sich umzusehen)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin seguimiento de cabeza (lleva el puntero al borde para mirar alrededor)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de suivi de la tête (amenez le pointeur au bord pour regarder autour)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun tracciamento (porta il puntatore al bordo per guardarti intorno)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドトラッキングなし(見回すにはポインターを端へ)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드 트래킹 없음 (둘러보려면 포인터를 가장자리로)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rastreamento da cabeça (leve o ponteiro à borda para olhar em volta)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет отслеживания головы (ведите указатель к краю, чтобы осмотреться)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无头部追踪（把指针拖到边缘可环顾四周）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無頭部追蹤（把指標拖到邊緣可環顧四周）"
          }
        }
      }
    },
    "No head tracking from the glasses": {
