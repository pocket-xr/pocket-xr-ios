    "The PIN was wrong. Close this PC screen and open it again to try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PIN war falsch. Schließ diesen PC-Bildschirm und öffne ihn erneut, um es noch einmal zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PIN no era correcto. Cierra esta pantalla del PC y vuelve a abrirla para intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code PIN était faux. Fermez cet écran du PC et rouvrez-le pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il PIN era sbagliato. Chiudi questo schermo del PC e riaprilo per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN が違いました。この PC 画面を閉じて開き直し、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN이 틀렸습니다. 이 PC 화면을 닫았다가 다시 열어 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PIN estava errado. Feche esta tela do PC e abra de novo para tentar outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный PIN. Закройте этот экран ПК и откройте снова, чтобы попробовать ещё раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 不正确。关闭这个电脑屏幕再重新打开以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 不正確。關閉這個電腦螢幕再重新打開以重試。"
          }
        }
      }
    },
