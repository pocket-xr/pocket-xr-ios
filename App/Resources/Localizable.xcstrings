          }
        }
      }
    },
    "Nothing to set on the glasses: Pocket XR sets the Aura's display itself, when iOS lets it reach the glasses' USB link.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der Brille ist nichts einzustellen: Pocket XR stellt die Anzeige der Aura selbst ein, wenn iOS die USB-Verbindung der Brille zulässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que ajustar en las gafas: Pocket XR configura la pantalla de las Aura, si iOS le deja llegar a su conexión USB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à régler sur les lunettes : Pocket XR règle l'affichage des Aura lui-même, si iOS le laisse joindre leur liaison USB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da impostare sugli occhiali: Pocket XR imposta il display degli Aura, se iOS gli consente di raggiungere il collegamento USB degli occhiali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラスで設定することはありません。iOS がグラスの USB リンクへの接続を許可すれば、Pocket XR が Aura の表示を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안경에서 설정할 것은 없습니다. iOS가 안경의 USB 연결을 허용하면 Pocket XR이 Aura의 화면을 직접 설정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a ajustar nos óculos: o Pocket XR configura a tela dos Aura, se o iOS permitir o acesso à conexão USB dos óculos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В очках ничего настраивать не нужно: Pocket XR сам настроит экран Aura, если iOS разрешит доступ к USB-соединению очков."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眼镜上无需设置：只要 iOS 允许访问眼镜的 USB 连接，Pocket XR 会自行设置 Aura 的显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "眼鏡上無需設定：只要 iOS 允許存取眼鏡的 USB 連線，Pocket XR 會自行設定 Aura 的顯示。"
          }
        }
      }
    },
    "On %1$@, type the PIN %2$@ in Apollo's or Sunshine's PIN page (%3$@), or in Pocket XR there when it asks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib auf %1$@ die PIN %2$@ auf der PIN-Seite von Apollo oder Sunshine (%3$@) ein, oder in Pocket XR dort, wenn es fragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %1$@, escribe el PIN %2$@ en la página de PIN de Apollo o Sunshine (%3$@), o en Pocket XR cuando lo pida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur %1$@, saisissez le code PIN %2$@ dans la page PIN d'Apollo ou Sunshine (%3$@), ou dans Pocket XR là-bas quand il le demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su %1$@, digita il PIN %2$@ nella pagina PIN di Apollo o Sunshine (%3$@), o in Pocket XR lì quando lo chiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ で、Apollo または Sunshine の PIN ページ(%3$@)に PIN %2$@ を入力するか、そこの Pocket XR に聞かれたら入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 Apollo나 Sunshine의 PIN 페이지(%3$@)에 PIN %2$@를 입력하거나, 그곳의 Pocket XR이 물으면 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %1$@, digite o PIN %2$@ na página de PIN do Apollo ou Sunshine (%3$@), ou no Pocket XR de lá quando pedir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$@ введите PIN %2$@ на странице PIN в Apollo или Sunshine (%3$@) либо в Pocket XR, когда он спросит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 %1$@ 上，在 Apollo 或 Sunshine 的 PIN 页面（%3$@）输入 PIN %2$@，或在那里的 Pocket XR 询问时输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 %1$@ 上，在 Apollo 或 Sunshine 的 PIN 頁面（%3$@）輸入 PIN %2$@，或在那裡的 Pocket XR 詢問時輸入。"
          }
        }
      }
    },
    "On %@, say Yes to let this phone show it (once).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag auf %@ Ja, damit dieses Telefon es zeigen darf (einmalig)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, di que sí para que este teléfono lo muestre (una vez)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur %@, répondez Oui pour que ce téléphone l'affiche (une fois)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su %@, rispondi Sì per permettere a questo telefono di mostrarlo (una volta)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で「はい」を選び、このスマートフォンでの表示を許可してください(1 回だけ)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 예를 눌러 이 휴대폰이 화면을 보여 주도록 허용하세요 (한 번만)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %@, diga Sim para deixar este celular mostrá-lo (uma vez)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ ответьте «Да», чтобы этот телефон мог его показывать (один раз)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 %@ 上选择“是”，允许这台手机显示它（仅一次）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 %@ 上選擇「是」，允許這部手機顯示它（僅一次）。"
          }
        }
      }
    },
