    "iOS does not let apps read the Air family's motion sensor, so there is no head tracking on iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS lässt Apps den Bewegungssensor der Air-Familie nicht lesen, daher gibt es auf dem iPhone kein Kopftracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no deja que las apps lean el sensor de movimiento de la familia Air, así que no hay seguimiento de cabeza en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne laisse pas les apps lire le capteur de mouvement de la famille Air : pas de suivi de la tête sur iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non consente alle app di leggere il sensore di movimento della famiglia Air, quindi su iPhone non c'è tracciamento della testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ではアプリが Air シリーズのモーションセンサーを読めないため、iPhone ではヘッドトラッキングはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 앱이 Air 계열의 모션 센서를 읽지 못하게 하므로 iPhone에서는 헤드 트래킹이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não deixa apps lerem o sensor de movimento da família Air, então não há rastreamento da cabeça no iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не даёт приложениям читать датчик движения семейства Air, поэтому на iPhone отслеживания головы нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许应用读取 Air 系列的运动传感器，因此 iPhone 上没有头部追踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允許 App 讀取 Air 系列的動作感測器，因此 iPhone 上沒有頭部追蹤。"
          }
        }
      }
    },
    "iOS does not let apps read the Beast's motion sensor. Use the Beast's own 3DoF hold and turn on Steady mode in Pocket XR.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS lässt Apps den Bewegungssensor der Beast nicht lesen. Nutze ihr eigenes 3DoF-Halten und schalte in Pocket XR den Steady-Modus ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no deja que las apps lean el sensor de movimiento de las Beast. Usa su propia sujeción 3DoF y activa el modo Steady en Pocket XR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne laisse pas les apps lire le capteur de mouvement des Beast. Utilisez leur propre maintien 3DoF et activez le mode Steady dans Pocket XR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non consente alle app di leggere il sensore di movimento dei Beast. Usa il loro blocco 3DoF e attiva la modalità Steady in Pocket XR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ではアプリが Beast のモーションセンサーを読めません。Beast 本体の 3DoF 固定を使い、Pocket XR で Steady モードをオンに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 앱이 Beast의 모션 센서를 읽지 못하게 합니다. Beast 자체의 3DoF 고정을 쓰고 Pocket XR에서 Steady 모드를 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não deixa apps lerem o sensor de movimento dos Beast. Use a fixação 3DoF dos próprios óculos e ative o modo Steady no Pocket XR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не даёт приложениям читать датчик движения Beast. Используйте собственное 3DoF-удержание очков и включите режим Steady в Pocket XR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许应用读取 Beast 的运动传感器。请使用 Beast 自带的 3DoF 固定，并在 Pocket XR 中打开 Steady 模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允許 App 讀取 Beast 的動作感測器。請使用 Beast 本身的 3DoF 固定，並在 Pocket XR 中打開 Steady 模式。"
          }
        }
      }
    }
  },
  "version": "1.0"
}