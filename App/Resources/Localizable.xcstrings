    "Drag up to push the window back, down to pull it closer. Tap to finish.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben ziehen schiebt das Fenster weg, nach unten holt es näher. Tippen zum Beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra hacia arriba para alejar la ventana y hacia abajo para acercarla. Toca para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers le haut pour éloigner la fenêtre, vers le bas pour la rapprocher. Touchez pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina in su per allontanare la finestra, in giù per avvicinarla. Tocca per finire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上にドラッグで奥へ、下にドラッグで手前へ。タップで終了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위로 드래그하면 창이 멀어지고, 아래로 드래그하면 가까워집니다. 탭하면 끝납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para cima para afastar a janela e para baixo para aproximá-la. Toque para terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите вверх, чтобы отодвинуть окно, вниз — чтобы приблизить. Коснитесь, чтобы закончить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上拖动把窗口推远，向下拖动拉近。轻点结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上拖動把視窗推遠，向下拖動拉近。輕點結束。"
          }
        }
      }
    },
    "For reading and working: the windows line up in front of you and the glasses hold the picture still.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Lesen und Arbeiten: Die Fenster reihen sich vor dir auf, und die Brille hält das Bild still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para leer y trabajar: las ventanas se alinean delante de ti y las gafas mantienen la imagen quieta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour lire et travailler : les fenêtres s'alignent devant vous et les lunettes tiennent l'image immobile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per leggere e lavorare: le finestre si allineano davanti a te e gli occhiali tengono fermo l'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書や作業に: ウィンドウが前に並び、グラスが画面を固定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽고 일할 때: 창이 앞에 나란히 서고 안경이 화면을 고정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ler e trabalhar: as janelas se alinham à sua frente e os óculos mantêm a imagem parada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для чтения и работы: окна выстраиваются перед вами, а очки держат изображение неподвижным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合阅读和工作：窗口在你面前排成一排，由眼镜保持画面稳定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適合閱讀和工作：視窗在你面前排成一排，由眼鏡保持畫面穩定。"
          }
        }
      }
    },
