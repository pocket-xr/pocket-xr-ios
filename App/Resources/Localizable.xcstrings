        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗：%@"
          }
        }
      }
    },
    "With Pocket XR on your Windows PC, Mac or Steam Deck, or with Apollo or Sunshine, open PC screen to see its desktop in the glasses. Up to three at once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Pocket XR auf deinem Windows-PC, Mac oder Steam Deck oder mit Apollo oder Sunshine öffnest du PC-Bildschirm und siehst den Desktop in der Brille. Bis zu drei gleichzeitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Pocket XR en tu PC con Windows, Mac o Steam Deck, o con Apollo o Sunshine, abre Pantalla del PC para ver su escritorio en las gafas. Hasta tres a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Pocket XR sur votre PC Windows, Mac ou Steam Deck, ou avec Apollo ou Sunshine, ouvrez Écran du PC pour voir son bureau dans les lunettes. Jusqu'à trois à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Pocket XR sul PC Windows, sul Mac o sullo Steam Deck, o con Apollo o Sunshine, apri Schermo del PC per vedere il desktop negli occhiali. Fino a tre insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows PC、Mac、Steam Deck の Pocket XR、または Apollo や Sunshine があれば、PC 画面を開いてデスクトップをグラスで見られます。同時に最大 3 つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows PC, Mac, Steam Deck의 Pocket XR이나 Apollo, Sunshine이 있으면 PC 화면을 열어 데스크톱을 안경에서 보세요. 최대 세 개까지 동시에."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o Pocket XR no seu PC Windows, Mac ou Steam Deck, ou com Apollo ou Sunshine, abra Tela do PC para ver a área de trabalho nos óculos. Até três ao mesmo tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С Pocket XR на ПК с Windows, Mac или Steam Deck либо с Apollo или Sunshine откройте «Экран ПК», чтобы видеть его рабочий стол в очках. До трёх сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑（Windows、Mac 或 Steam Deck）上装有 Pocket XR，或装有 Apollo 或 Sunshine 时，打开电脑屏幕即可在眼镜中看到桌面。最多同时三个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦（Windows、Mac 或 Steam Deck）上裝有 Pocket XR，或裝有 Apollo 或 Sunshine 時，打開電腦螢幕即可在眼鏡中看到桌面。最多同時三個。"
          }
        }
      }
    },
    "Without head tracking on this iPhone, use Anchor mode instead and turn on Steady mode in Pocket XR: the glasses hold the picture.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Kopftracking auf diesem iPhone nutze stattdessen Anchor und schalte in Pocket XR den Steady-Modus ein: Die Brille hält das Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin seguimiento de cabeza en este iPhone, usa el modo Anchor y activa el modo Steady en Pocket XR: las gafas sujetan la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans suivi de la tête sur cet iPhone, utilisez plutôt le mode Anchor et activez le mode Steady dans Pocket XR : les lunettes tiennent l'image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza tracciamento della testa su questo iPhone, usa la modalità Anchor e attiva la modalità Steady in Pocket XR: gli occhiali tengono fermo l'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone でヘッドトラッキングがない場合は、代わりに Anchor モードにして Pocket XR で Steady モードをオンに。グラスが画面を固定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 헤드 트래킹이 없으면 대신 Anchor 모드를 쓰고 Pocket XR에서 Steady 모드를 켜세요. 안경이 화면을 고정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rastreamento da cabeça neste iPhone, use o modo Anchor e ative o modo Steady no Pocket XR: os óculos seguram a imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если на этом iPhone нет отслеживания головы, включите в очках Anchor, а в Pocket XR — режим Steady: очки удерживают изображение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此 iPhone 上没有头部追踪，请改用 Anchor 模式，并在 Pocket XR 中打开 Steady 模式：由眼镜固定画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此 iPhone 上沒有頭部追蹤，請改用 Anchor 模式，並在 Pocket XR 中打開 Steady 模式：由眼鏡固定畫面。"
          }
        }
      }
    },
