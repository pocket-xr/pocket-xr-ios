    "Press X on the glasses once and pick Follow mode, not Anchor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke einmal X an der Brille und wähle Follow, nicht Anchor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa X una vez en las gafas y elige el modo Follow, no Anchor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez une fois sur X sur les lunettes et choisissez le mode Follow, pas Anchor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi X una volta sugli occhiali e scegli la modalità Follow, non Anchor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラスの X を 1 回押して、Anchor ではなく Follow モードを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안경의 X를 한 번 누르고 Anchor가 아닌 Follow 모드를 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione X uma vez nos óculos e escolha o modo Follow, não Anchor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите X на очках один раз и выберите режим Follow, а не Anchor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在眼镜上按一次 X，选择 Follow 模式，而不是 Anchor。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在眼鏡上按一次 X，選擇 Follow 模式，而不是 Anchor。"
          }
        }
      }
    },
    "Press X twice for the glasses' menu: Spatial Screen, Stabilizer, off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke zweimal X für das Brillenmenü: Spatial Screen, Stabilizer, aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa X dos veces para el menú de las gafas: Spatial Screen, Stabilizer, desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez deux fois sur X pour le menu des lunettes : Spatial Screen, Stabilizer, désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi X due volte per il menu degli occhiali: Spatial Screen, Stabilizer, disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X を 2 回押してグラスのメニューを開き、Spatial Screen の Stabilizer をオフに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "X를 두 번 눌러 안경 메뉴를 열고 Spatial Screen, Stabilizer를 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione X duas vezes para o menu dos óculos: Spatial Screen, Stabilizer, desligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите X дважды для меню очков: Spatial Screen, Stabilizer — выкл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按两次 X 打开眼镜菜单：Spatial Screen，Stabilizer，关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按兩次 X 打開眼鏡選單：Spatial Screen，Stabilizer，關閉。"
          }
        }
      }
    },
