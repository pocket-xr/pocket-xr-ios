{
  "sourceLanguage": "en",
  "strings": {
    "A spatial workspace for your XR glasses, run from this iPhone or iPad. Plug the glasses into the USB-C port and the Space opens on them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein räumlicher Arbeitsplatz für deine XR-Brille, von diesem iPhone oder iPad aus. Steck die Brille in den USB-C-Anschluss, und der Space öffnet sich darin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio de trabajo espacial para tus gafas XR, desde este iPhone o iPad. Conecta las gafas al puerto USB-C y el Space se abre en ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace de travail spatial pour vos lunettes XR, depuis cet iPhone ou iPad. Branchez les lunettes sur le port USB-C et le Space s'y ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spazio di lavoro per i tuoi occhiali XR, da questo iPhone o iPad. Collega gli occhiali alla porta USB-C e lo Space si apre su di essi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone や iPad で動く、XR グラスのための空間ワークスペースです。グラスを USB-C ポートに挿すと Space が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone이나 iPad로 쓰는 XR 안경용 공간 작업 환경입니다. 안경을 USB-C 포트에 꽂으면 Space가 안경에 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaço de trabalho espacial para seus óculos XR, a partir deste iPhone ou iPad. Conecte os óculos na porta USB-C e o Space abre neles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пространственное рабочее место для ваших XR-очков, прямо с этого iPhone или iPad. Подключите очки к USB-C, и Space откроется в них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个由这台 iPhone 或 iPad 运行的 XR 眼镜空间工作区。把眼镜插入 USB-C 接口，Space 就会在眼镜上打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個由這部 iPhone 或 iPad 執行的 XR 眼鏡空間工作區。把眼鏡插入 USB-C 連接埠，Space 就會在眼鏡上打開。"
          }
        }
      }
    },
