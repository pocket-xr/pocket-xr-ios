    "Drag to move every window, pinch to resize them all. Tap to finish.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen verschiebt alle Fenster, Kneifen ändert alle Größen. Tippen zum Beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover todas las ventanas, pellizca para cambiar su tamaño. Toca para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer toutes les fenêtres, pincez pour toutes les redimensionner. Touchez pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per spostare tutte le finestre, pizzica per ridimensionarle. Tocca per finire."
