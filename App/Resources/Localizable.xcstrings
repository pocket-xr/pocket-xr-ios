    "Larger text on 1080p glasses: web pages and PC screens get a third bigger. In the Control Center.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Schrift auf 1080p-Brillen: Webseiten und PC-Bildschirme werden ein Drittel größer. Im Kontrollzentrum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto más grande en gafas 1080p: las páginas web y las pantallas del PC crecen un tercio. En el Centro de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte plus grand sur les lunettes 1080p : pages web et écrans du PC grossissent d'un tiers. Dans le Centre de contrôle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo più grande sugli occhiali 1080p: pagine web e schermi del PC più grandi di un terzo. Nel Centro di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p グラスで大きな文字に: Web ページと PC 画面が 3 分の 1 大きくなります。コントロールセンターから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p 안경에서 더 큰 글자: 웹 페이지와 PC 화면이 3분의 1 커집니다. 제어 센터에 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto maior em óculos 1080p: páginas da web e telas do PC ficam um terço maiores. Na Central de controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупнее текст на очках 1080p: веб-страницы и экраны ПК на треть больше. В Пункте управления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 1080p 眼镜上让文字更大：网页和电脑屏幕放大三分之一。在控制中心中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 1080p 眼鏡上讓文字更大：網頁和電腦螢幕放大三分之一。在控制中心中。"
          }
        }
      }
    },
