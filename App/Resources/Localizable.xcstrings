    "The windows stay in front of you; drag the pointer to the edge of the view to look around.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fenster bleiben vor dir; zieh den Zeiger an den Rand der Ansicht, um dich umzusehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas se quedan delante; arrastra el puntero al borde de la vista para mirar alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres restent devant vous ; amenez le pointeur au bord de la vue pour regarder autour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre restano davanti a te; trascina il puntatore al bordo della vista per guardarti intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウは前に留まります。見回すにはポインターを視界の端までドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창은 앞에 머뭅니다. 둘러보려면 포인터를 화면 가장자리로 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas ficam à sua frente; arraste o ponteiro até a borda da visão para olhar em volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна остаются перед вами; чтобы осмотреться, ведите указатель к краю вида."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口会留在你面前；把指针拖到视野边缘即可环顾四周。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗會留在你面前；把指標拖到視野邊緣即可環顧四周。"
          }
        }
      }
    },
