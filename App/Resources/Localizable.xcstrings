        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで全ウィンドウを移動、ピンチで全サイズ変更。タップで終了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하면 모든 창이 움직이고, 핀치하면 모두 크기가 바뀝니다. 탭하면 끝납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover todas as janelas, faça pinça para redimensioná-las. Toque para terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите, чтобы переместить все окна, сведите пальцы, чтобы изменить их размер. Коснитесь, чтобы закончить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
